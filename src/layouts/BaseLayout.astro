---
import "@fontsource-variable/newsreader";
import "@fontsource-variable/manrope";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { business } from "../data/business";

type Breadcrumb = {
  name: string;
  path: string;
};

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  pageType?: "WebPage" | "AboutPage" | "ContactPage" | "CollectionPage";
  breadcrumbs?: Breadcrumb[];
  schemas?: Record<string, unknown>[];
  noindex?: boolean;
  canonicalEnabled?: boolean;
  includeSchema?: boolean;
}

const {
  title,
  description,
  path,
  image = "/images/fort-worth-cleaning-hero.webp",
  pageType = "WebPage",
  breadcrumbs = [],
  schemas = [],
  noindex = false,
  canonicalEnabled = true,
  includeSchema = true
} = Astro.props;

const site = Astro.site ?? new URL("https://rangeriver.vercel.app");
const canonical = new URL(path, site);
const socialImage = new URL(image, site);
const organizationId = new URL("/#organization", site).href;
const websiteId = new URL("/#website", site).href;
const webpageId = `${canonical.href}#webpage`;

const graph: Record<string, unknown>[] = [];
const siteIndexable = import.meta.env.PUBLIC_SITE_INDEXABLE === "true";
const robotsContent = noindex
  ? "noindex,follow"
  : siteIndexable
    ? "index,follow,max-image-preview:large"
    : "noindex,nofollow";

if (includeSchema) {
  graph.push({
    "@type": "Organization",
    "@id": organizationId,
    name: business.name,
    url: site.href,
    description: business.description,
    telephone: business.phoneE164,
    contactPoint: {
      "@type": "ContactPoint",
      telephone: business.phoneE164,
      contactType: "customer service",
      areaServed: "Fort Worth, Texas"
    },
    areaServed: {
      "@type": "City",
      name: business.city,
      containedInPlace: {
        "@type": "State",
        name: "Texas"
      }
    }
  }, {
    "@type": "WebSite",
    "@id": websiteId,
    name: business.name,
    url: site.href,
    publisher: { "@id": organizationId },
    inLanguage: "en-US"
  }, {
    "@type": pageType,
    "@id": webpageId,
    name: title,
    description,
    url: canonical.href,
    isPartOf: { "@id": websiteId },
    about: { "@id": organizationId },
    inLanguage: "en-US"
  });
}

if (includeSchema && breadcrumbs.length > 0) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.path, site).href
    }))
  });
}

if (includeSchema) graph.push(...schemas);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#123b3a" />
    <meta
      name="robots"
      content={robotsContent}
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalEnabled && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta
      property="og:image:alt"
      content="A warm, freshly cleaned Fort Worth home interior used as an illustrative brand image."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {includeSchema && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <Footer />
    <div class="mobile-action" aria-label="Quick action">
      <a href={business.phoneHref}>Call Doug <span>{business.phone}</span></a>
    </div>
  </body>
</html>
