---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import { services, faqs } from "../data/business";
---

<BaseLayout
  title="Fort Worth Residential & Commercial Cleaning | Range & River"
  description="Explore residential, commercial, deep, move, office, and janitorial cleaning requests in Fort Worth with Range & River Cleaning Co."
  path="/"
>
  <main>
    <section class="home-hero">
      <div class="home-hero-media">
        <img
          src="/images/fort-worth-cleaning-hero.webp"
          width="1536"
          height="1024"
          alt="A warm Fort Worth inspired home interior, used as an illustrative brand image."
          fetchpriority="high"
        />
      </div>
      <div class="shell home-hero-content">
        <div>
          <span class="hero-stamp">A Fort Worth cleaning field guide</span>
          <h1>Cleaning for the places Fort Worth <em>lives</em> and works.</h1>
          <p>Tell us what kind of property you have, what needs attention, and when you need it. Start with a clear residential or commercial quote path.</p>
          <div class="hero-actions">
            <a class="button button-light" href="/quote/?path=residential">Request a residential quote</a>
            <a class="button hero-outline" href="/quote/?path=commercial">Request a commercial quote</a>
          </div>
        </div>
        <aside class="hero-key">
          <span>R&amp;R / FW</span>
          <p>Residential</p>
          <p>Commercial</p>
          <p>Fort Worth, Texas</p>
        </aside>
      </div>
      <div class="hero-ledger">
        <div class="shell">
          <span>Fort Worth focused</span>
          <span>Separate home and workplace paths</span>
          <span>Property specific quote details</span>
        </div>
      </div>
    </section>

    <section class="section path-section">
      <div class="shell">
        <div class="section-heading">
          <div>
            <span class="kicker">Choose the property</span>
            <h2>Two spaces. Two ways to start.</h2>
          </div>
          <p>A house and a workplace ask different questions. Choose the path that matches the property, then define the scope from there.</p>
        </div>
        <div class="path-cards">
          <a class="path-card path-home" href="/residential-cleaning/">
            <span class="path-index">01 / Home</span>
            <div>
              <h3>For the place you come home to.</h3>
              <p>Start with the home, its approximate size, and the kind of attention it needs. Use this path for general, deep, move, or frequency based requests.</p>
              <span class="text-link">Explore residential cleaning <b aria-hidden="true">→</b></span>
            </div>
          </a>
          <a class="path-card path-work" href="/commercial-cleaning/">
            <span class="path-index">02 / Work</span>
            <div>
              <h3>For the place your team gets work done.</h3>
              <p>Share the property type, approximate size, priority areas, access needs, desired timing, and frequency preference.</p>
              <span class="text-link">Explore commercial cleaning <b aria-hidden="true">→</b></span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="section service-section">
      <div class="shell">
        <div class="section-heading compact-heading">
          <div>
            <span class="kicker">Cleaning paths</span>
            <h2>Start with the closest fit.</h2>
          </div>
          <a class="text-link" href="/what-we-clean/">Open the room and area guide <span aria-hidden="true">→</span></a>
        </div>
        <div class="card-grid">
          {services.map((service, index) => (
            <a class="service-card" href={service.href}>
              <span class="card-index"><span>{service.eyebrow}</span><span>{String(index + 1).padStart(2, "0")}</span></span>
              <h3>{service.name}</h3>
              <p>{service.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section field-notes-section">
      <div class="shell notes-layout">
        <div class="notes-intro">
          <span class="kicker light">The Range &amp; River method</span>
          <h2>Give us the lay of the land.</h2>
          <p>Every useful request starts with a clear picture of the property, the priorities, and the boundaries of the work.</p>
          <a class="button button-light" href="/quote/">Build your request</a>
        </div>
        <div class="field-notes">
          <article>
            <span>Field note 01</span>
            <h3>Start with the space.</h3>
            <p>Share the property type, approximate size, service requested, city and ZIP code, desired timing, and frequency preference.</p>
          </article>
          <article>
            <span>Field note 02</span>
            <h3>Name the priorities.</h3>
            <p>Identify the rooms, surfaces, trouble spots, access details, or special circumstances that matter most.</p>
          </article>
          <article>
            <span>Field note 03</span>
            <h3>Confirm the boundaries.</h3>
            <p>Before scheduling, confirm included tasks, exclusions, supplies, access, availability, timing, and the final quote.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section fort-worth-section">
      <div class="shell fort-worth-grid">
        <div class="location-graphic" aria-hidden="true">
          <span>Fort Worth</span>
          <strong>TX</strong>
          <i></i>
        </div>
        <div>
          <span class="kicker">Service area 01</span>
          <h2>Fort Worth is the starting point.</h2>
          <p class="section-intro">Fort Worth is the confirmed primary market. Exact boundaries and nearby cities are not published yet, so each request includes the property ZIP code for a coverage check.</p>
          <a class="text-link" href="/service-area/fort-worth/">Read the Fort Worth service area guide <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section home-faq-section">
      <div class="shell faq-grid">
        <div>
          <span class="kicker">Direct answers</span>
          <h2>Questions before the quote.</h2>
          <p class="section-intro">These answers reflect what is known today. Unconfirmed policies, prices, hours, and contact details stay off the site until Doug approves them.</p>
          <a class="text-link" href="/faq/">Read every answer <span aria-hidden="true">→</span></a>
        </div>
        <div class="faq-list compact-faq">
          {faqs.slice(0, 4).map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <CTASection title="Tell us about the space." copy="Choose home or workplace, then share the property details, priorities, and timing that shape the quote." />
</BaseLayout>
